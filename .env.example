# Database Connection (Supabase / Neon / Local Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/up_civic

# Netlify Build Hook (for Admin snapshot publishing)
NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/sample_hook_id

# Admin Authentication
ADMIN_JWT_SECRET=super-secret-jwt-key-replace-in-production
ADMIN_DEFAULT_EMAIL=admin@upcivic.in

# Report Salt Secret
REPORT_SALT_SECRET=daily-salt-generation-secret-key

# Maintainer Contact
MAINTAINER_EMAIL=support@upcivic.in
